# Port the bot's webhook server listens on
PORT=8787

# Shared secret — must match ZALO_BOT_WEBHOOK_SECRET set on the wedding site's
# server (Cloudflare). Requests without a matching x-webhook-secret header are rejected.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional but required for Render (or any host without a persistent disk):
# persists the Zalo login session in Supabase instead of a local file, so it
# survives service restarts. Same project as the wedding site — get these
# from Supabase Dashboard -> Project Settings -> API. Leave both empty to
# fall back to a local credentials.json file (fine for local testing only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
